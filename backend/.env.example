# Copy to .env (setup.ps1 does this) and fill in once you have model access.
# Never commit .env. Use synthetic data only.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_S=60
# true if the provider supports response_format {"type": "json_object"}
MODEL_JSON_MODE=false
# Output caps per task (tokens; include hidden reasoning)
MAX_TOKENS_EXPLAIN=2000
MAX_TOKENS_CHECKLIST=1800
MAX_TOKENS_OPEN_SPACE=8000
REASONING_EFFORT_OPEN_SPACE=low
MAX_TOKENS_JSON=1200
MAX_TOKENS_DRAWING=8000
# Hidden reasoning per call: minimal | low | medium | high. Empty = provider default.
REASONING_EFFORT=minimal
REASONING_EFFORT_DRAWING=low
# LBP estimate when a drawing gives only LOA (share of LOA)
LBP_FROM_LOA=0.94
# Drawing reader (multimodal), e.g. Muse Spark or Muse Wonder. Empty = MODEL_NAME.
READER_MODEL_NAME=
# SAM 3.1 segmentation for uploaded drawings. Empty base URL = MODEL_BASE_URL.
SEGMENT_BASE_URL=
SEGMENT_MODEL_NAME=
# Muse Image (reserved for vessel sketches, not used yet)
IMAGE_MODEL_NAME=
FRONTEND_ORIGIN=http://localhost:5173
# Signs login tokens. Leave empty to have one generated in data/users/.secret.
SECRET_KEY=
# Demo account created at start-up (synthetic data only). Share these with the judges.
DEMO_USER_EMAIL=demo@stowage-ai.example
DEMO_USER_PASSWORD=DemoFjord-2026
